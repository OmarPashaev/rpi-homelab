FORGEJO_VERSION=15
FORGEJO_DOMAIN=git.home.lan
FORGEJO_SSH_PORT=2222

# Deliberately unset. Alpine/musl without tzdata: a set TZ overrides
# /etc/localtime and silently falls back to UTC.
# TZ=Europe/Oslo

# Must match the owner of forgejo/data on the host, or writes fail silently.
USER_UID=1000
USER_GID=1000
